# ============================================================================
# 1. CẤU HÌNH SERVER & MÔI TRƯỜNG
# ============================================================================
APP_ENV=development
HTTP_PORT=8080
LOG_LEVEL=info

# ============================================================================
# 2. CẤU HÌNH DATABASE (POSTGRESQL) & REDIS
# ============================================================================
DATABASE_URL=postgres://fbposter:fbposter_secret@localhost:5432/fb_autoposter?sslmode=disable
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# ============================================================================
# 3. BẢO MẬT & MÃ HÓA TOKEN (AES-256-GCM)
# Bắt buộc dài đúng 32 bytes (256-bit) hoặc 64 ký tự hex
# ============================================================================
TOKEN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
API_ADMIN_KEY=dev-admin-secret-key-change-me

# ============================================================================
# 4. CẤU HÌNH META / FACEBOOK GRAPH API
# ============================================================================
FB_GRAPH_VERSION=v20.0
FB_GRAPH_BASE_URL=https://graph.facebook.com
FB_APP_ID=your_facebook_app_id
FB_APP_SECRET=your_facebook_app_secret
FB_REDIRECT_URI=http://localhost:8080/api/v1/auth/facebook/callback
FB_WEBHOOK_VERIFY_TOKEN=my_secure_webhook_verify_token

# ============================================================================
# 5. CẤU HÌNH LƯU TRỮ MEDIA (MINIO / AWS S3 / CLOUDFLARE R2)
# ============================================================================
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_BASE_URL=http://localhost:9000/fb-media
S3_REGION=us-east-1
S3_BUCKET=fb-media
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123

# ============================================================================
# 6. CẤU HÌNH WORKER & SCHEDULER
# ============================================================================
SCHEDULER_INTERVAL_SEC=15
TOKEN_CHECK_INTERVAL_HOURS=12
FAST_WORKER_CONCURRENCY=4
HEAVY_WORKER_CONCURRENCY=2
RATE_LIMIT_THRESHOLD_PERCENT=80
VIDEO_CHUNK_SIZE_BYTES=4194304

# ============================================================================
# 7. TÍCH HỢP AI (GEMINI API) & CẢNH BÁO (TELEGRAM BOT)
# ============================================================================
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
